# syntax=docker/dockerfile:1
ARG VLLM_IMAGE=docker.io/vllm/vllm-openai:v0.34.0@sha256:20fdb089454afbb324efa4110a2c025ff7b27cc1a086e07aa580b18df8ad1ce1
ARG CUDA_IMAGE=docker.io/nvidia/cuda:13.0.3-devel-ubuntu24.04@sha256:b7ae301dea2c162444795462ce17a05f6a516e5a75944b57af5b88540a1a2266
FROM ${CUDA_IMAGE} AS toolkit

FROM ${VLLM_IMAGE} AS lmcache-build
ARG JOBS
ARG LMCACHE_REF=2acb7b24bea5ac55c5dfc6a41366099236ec525c
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=from=toolkit,source=/usr/local/cuda-13.0,target=/usr/local/cuda-13.0,ro \
    --mount=type=bind,source=lmcache-torch-cxx.patch,target=/tmp/lmcache-torch-cxx.patch,ro \
    set -eu; export CUDA_HOME=/usr/local/cuda-13.0 PATH="/usr/local/cuda-13.0/bin:$PATH"; \
    export TORCH_CUDA_ARCH_LIST=8.0 BUILD_WITH_CUDA=1 NVCC_THREADS=1 MAX_JOBS="$JOBS"; \
    python3 -c 'import torch; assert torch.version.cuda == "13.0", torch.version.cuda'; \
    git clone --quiet https://github.com/wtdcode/LMCache.git /tmp/lmcache; \
    cd /tmp/lmcache; git checkout -q --detach "$LMCACHE_REF"; test "$(git rev-parse HEAD)" = "$LMCACHE_REF"; \
    git apply /tmp/lmcache-torch-cxx.patch; \
    python3 -m pip install --no-cache-dir -r requirements/build.txt; \
    python3 -m pip wheel --no-cache-dir --no-build-isolation --no-deps -w /out .

FROM ${VLLM_IMAGE}
RUN --mount=type=bind,source=wheels,target=/port-wheel,ro \
    --mount=from=lmcache-build,source=/out,target=/lmcache-wheel,ro \
    set -eu; \
    python3 -m pip install --no-cache-dir --no-deps --force-reinstall /port-wheel/vllm-*.whl; \
    uv pip freeze --system | grep -E '^(vllm|torch|torchaudio|torchvision|triton|cuda-bindings|cuda-python|cuda-toolkit)==' > /tmp/lmcache-constraints.txt; \
    uv pip install --no-cache --system -c /tmp/lmcache-constraints.txt --reinstall-package lmcache /lmcache-wheel/*.whl; \
    rm /tmp/lmcache-constraints.txt; \
    python3 -c "import torch, lmcache; from vllm.v1.attention.ops import fp8_sm80"; \
    lmcache --help >/dev/null
RUN --mount=from=toolkit,source=/usr/local/cuda-13.0,target=/usr/local/cuda-13.0,ro <<'CHECK_EXTENSIONS'
set -eu
# The builder has no GPU driver. Use the toolkit's driver stub only for this
# import check. The published image and A100 runtime do not include the stub.
linkcheck=$(mktemp -d)
ln -s /usr/local/cuda-13.0/targets/x86_64-linux/lib/stubs/libcuda.so "$linkcheck/libcuda.so.1"
LD_LIBRARY_PATH="$linkcheck:${LD_LIBRARY_PATH:-}" python3 - <<'PY'
import importlib
import re
import subprocess

import torch

for name in ("vllm._C_stable_libtorch", "lmcache.cuda_ops"):
    extension = importlib.import_module(name)
    path = extension.__file__
    listing = subprocess.check_output(
        ["/usr/local/cuda-13.0/bin/cuobjdump", "--list-elf", path], text=True
    )
    if not re.search(r"sm_80(?:[^0-9]|$)", listing):
        raise SystemExit(f"Missing SM80 device code in {path}")
    print(f"Verified native sm_80 device code in {path}", flush=True)
PY
rm -r "$linkcheck"
CHECK_EXTENSIONS
