# syntax=docker/dockerfile:1
ARG VLLM_IMAGE
ARG CUDA_IMAGE
FROM ${CUDA_IMAGE} AS toolkit

FROM ${VLLM_IMAGE} AS lmcache-build
ARG JOBS
ARG LMCACHE_REF=2acb7b24bea5ac55c5dfc6a41366099236ec525c
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=from=toolkit,source=/usr/local/cuda-13.0,target=/usr/local/cuda-13.0,ro \
    set -eu; export CUDA_HOME=/usr/local/cuda-13.0 PATH="/usr/local/cuda-13.0/bin:$PATH"; \
    export TORCH_CUDA_ARCH_LIST=8.0 BUILD_WITH_CUDA=1 NVCC_THREADS=1 MAX_JOBS="$JOBS"; \
    python3 -c 'import torch; assert torch.version.cuda == "13.0", torch.version.cuda'; \
    git clone --quiet https://github.com/wtdcode/LMCache.git /tmp/lmcache; \
    cd /tmp/lmcache; git checkout -q --detach "$LMCACHE_REF"; test "$(git rev-parse HEAD)" = "$LMCACHE_REF"; \
    python3 -m pip install --no-cache-dir -r requirements/build.txt; \
    python3 -m pip wheel --no-cache-dir --no-build-isolation --no-deps -w /out .

FROM ${VLLM_IMAGE}
RUN --mount=type=bind,source=wheels,target=/port-wheel,ro \
    --mount=from=lmcache-build,source=/out,target=/lmcache-wheel,ro \
    set -eu; \
    python3 -m pip install --no-cache-dir --no-deps --force-reinstall /port-wheel/vllm-*.whl; \
    uv pip freeze --system | grep -E '^(vllm|torch|torchaudio|torchvision|triton|cuda-bindings|cuda-python|cuda-toolkit)==' > /tmp/lmcache-constraints.txt; \
    uv pip install --no-cache --system -c /tmp/lmcache-constraints.txt --reinstall-package lmcache /lmcache-wheel/*.whl; \
    rm /tmp/lmcache-constraints.txt; \
    python3 -c "import torch, lmcache, vllm._C; from vllm.v1.attention.ops import fp8_sm80"; \
    lmcache --help >/dev/null
RUN --mount=from=toolkit,source=/usr/local/cuda-13.0,target=/usr/local/cuda-13.0,ro python3 - <<'PY'
import re
import subprocess
from importlib.metadata import distribution
from pathlib import Path

def contains_sm80(path):
    result = subprocess.run(
        ["/usr/local/cuda-13.0/bin/cuobjdump", "--list-elf", str(path)],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
    )
    return result.returncode == 0 and re.search(r"sm_80(?:[^0-9]|$)", result.stdout)

for package, pattern in (("vllm", "_C*.so"), ("lmcache", "cuda_ops*.so")):
    module_dir = Path(distribution(package).locate_file(package))
    matches = [p.name for p in sorted(module_dir.glob(pattern)) if contains_sm80(p)]
    if not matches:
        raise SystemExit(f"Missing SM80 device code in {module_dir}/{pattern}")
    print(f"Verified native sm_80 device code in {package}: {matches}", flush=True)
PY
